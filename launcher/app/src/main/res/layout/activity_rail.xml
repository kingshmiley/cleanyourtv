<?xml version="1.0" encoding="utf-8"?>
<!-- The rail home (RailActivity, docs/rail-home.md): a frosted rail on the left with the clock, weather and the
     Inputs / Wi-Fi / Settings rows; favourites in a carousel over their artwork on the right; every app below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/railRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF08090B"
    android:clipChildren="false">

    <View
        android:id="@+id/railGlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:id="@+id/heroHolder"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginStart="260dp" />

    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/rail_panel"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="17dp"
        android:paddingTop="24dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/railGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.24"
            android:textAllCaps="true"
            android:textColor="#FF969AA0"
            android:textSize="8sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/railClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extralight"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="#FFF5F6F8"
                android:textSize="66sp" />

            <TextClock
                android:id="@+id/railAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="9dp"
                android:fontFamily="@font/outfit_medium"
                android:format12Hour="a"
                android:format24Hour=""
                android:textAllCaps="true"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/railDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/outfit_light"
            android:format12Hour="EEEE, MMMM d"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#FF969AA0"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:id="@+id/railWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/railWxIcon"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/railWxTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/outfit_extralight"
                android:includeFontPadding="false"
                android:textColor="#FFF5F6F8"
                android:textSize="33sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/railWxText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit_medium"
                    android:maxWidth="100dp"
                    android:singleLine="true"
                    android:textColor="#FFF5F6F8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/railWxHiLo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit_regular"
                    android:singleLine="true"
                    android:textColor="#FF969AA0"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/railWxAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/status_pill"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_medium"
            android:maxWidth="196dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="#FF2D1C00"
            android:textSize="9sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/railDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginBottom="12dp"
            android:background="#1AFFFFFF" />

        <LinearLayout
            android:id="@+id/railRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-7dp"
            android:orientation="vertical" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/railRight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="274dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="34dp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.25"
            android:text="@string/rail_favorites"
            android:textColor="#FFDCE0E4"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/railCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="34dp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.15"
            android:textSize="8sp" />

        <FrameLayout
            android:id="@+id/carouselHolder"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="55dp"
            android:clipChildren="false" />

        <TextView
            android:id="@+id/favName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="224dp"
            android:fontFamily="@font/outfit_regular"
            android:singleLine="true"
            android:textColor="#FFF5F6F8"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/favSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="252dp"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_light"
            android:maxWidth="520dp"
            android:singleLine="true"
            android:textColor="#FFB4B8BE"
            android:textSize="9.5sp" />

        <LinearLayout
            android:id="@+id/favDots"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="273dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="296dp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.25"
            android:text="@string/rail_all_apps"
            android:textColor="#FF969AA0"
            android:textSize="8sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/railGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="310dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />
    </FrameLayout>
</FrameLayout>
